# Free key: https://collegefootballdata.com/key
CFBD_API_KEY=
# Optional. Leave blank to use "copy for Claude" mode with your claude.ai subscription (no API key, no extra cost).
# Fill it in (https://console.anthropic.com/settings/keys, billed separately) for one-click predictions.
ANTHROPIC_API_KEY=
# manual | api   (default: api when ANTHROPIC_API_KEY is set, otherwise manual)
# PICKS_CLAUDE_MODE=manual

# Optional
# Sportsbook to take lines from (e.g. DraftKings, ESPN Bet, Bovada). Falls back to the first available.
LINES_PROVIDER=DraftKings
PICKS_CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (higher = more thorough, more tokens)
PICKS_CLAUDE_EFFORT=high
PORT=5050
# Optional: self-hosted NCAA API (https://github.com/henrygd/ncaa-api); defaults to the public instance
# NCAA_API_URL=https://ncaa-api.henrygd.me
